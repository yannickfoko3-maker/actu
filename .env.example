# ---------------------------------------------------------------------------
# ACES GLOBAL SERVICES — configuration du backend
# Copiez ce fichier en « .env » puis adaptez les valeurs.
# Ne committez jamais le fichier .env réel.
# ---------------------------------------------------------------------------

# Environnement : development | production
NODE_ENV=development

# Port de l'API Express
PORT=4000

# URL du site public et de l'API (utilisées pour le sitemap et les e-mails)
APP_URL=http://localhost:5173
API_URL=http://localhost:4000

# Origines autorisées pour les requêtes navigateur (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Base de données MySQL 8 / MariaDB
# ---------------------------------------------------------------------------
# Format : mysql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/NOM_DE_LA_BASE
# Avec XAMPP (MySQL par défaut) :
#   DATABASE_URL="mysql://root:@localhost:3306/aces_global_services"
DATABASE_URL="mysql://root:motdepasse@localhost:3306/aces_global_services"

# Adaptateur de données :
#   prisma = MySQL via Prisma (production, recommandé)
#   memory = magasin JSON local (démonstration / tests, sans MySQL)
DATA_ADAPTER=prisma

# Fichier utilisé uniquement lorsque DATA_ADAPTER=memory
# DATA_FILE=./.data/db.json

# ---------------------------------------------------------------------------
# Sécurité
# ---------------------------------------------------------------------------
# Générez une clé solide : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=remplacez-moi-par-une-cle-aleatoire-de-48-octets
JWT_EXPIRES_IN=8h
AUTH_COOKIE_NAME=aces_session
# Activer impérativement en production (HTTPS)
COOKIE_SECURE=false
# lax | strict | none (utiliser « none » + HTTPS si le site et l'API sont sur des domaines différents)
COOKIE_SAMESITE=lax

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=400
RATE_LIMIT_FORM_MAX=12

# ---------------------------------------------------------------------------
# Téléversements
# ---------------------------------------------------------------------------
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_MB=8

# ---------------------------------------------------------------------------
# Compte administrateur créé par le script de données initiales
# ---------------------------------------------------------------------------
SEED_ADMIN_NAME=Administrateur ACES
SEED_ADMIN_EMAIL=admin@aces-globalservices.com
SEED_ADMIN_PASSWORD=AcesAdmin2025!

# ---------------------------------------------------------------------------
# Notifications e-mail (facultatif — laisser vide si non configuré)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ACES Global Services <no-reply@aces-globalservices.com>
CONTACT_RECEIVER=aces.globalservices@gmail.com
